# Ignore private folders
/private/

# Ignore Photoshop files
*.psd

# Optional: ignore backups or exports
*.zip
*.bak

# Optional: ignore log and temp files
*.log
*.tmp

# Ignore Mac system files (recommended)
.DS_Store

# Ignore OS-specific hidden files
Thumbs.db

# Ignore Node.js dependencies
node_modules/

# Optional: ignore VS Code settings
.vscode/